# ============================================================
# Material-LIMS 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入真实值。
# .env 已加入 .gitignore，不会被提交到 Git。
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=lims
POSTGRES_USER=lims
POSTGRES_PASSWORD=lims_dev_password

# ---- Redis ----
REDIS_PASSWORD=

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ---- Spring Boot ----
SPRING_PROFILES_ACTIVE=dev

# ---- JWT (生产环境必须改为强随机密钥!) ----
SECURITY_JWT_SECRET=lims-dev-secret-32bytes-long-key!!
