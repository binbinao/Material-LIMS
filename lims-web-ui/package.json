{
  "name": "lims-web-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Material LIMS Frontend",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "start": "npm run dev",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lint:js": "eslint --cache --ext .js,.jsx,.ts,.tsx ./src",
    "lint:fix": "eslint --fix --cache --ext .js,.jsx,.ts,.tsx ./src",
    "lint:prettier": "prettier --check 'src/**/*' --end-of-line auto",
    "prettier": "prettier --write 'src/**/*' --end-of-line auto",
    "test": "jest",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@ant-design/pro-components": "^2.6.0",
    "@ant-design/pro-layout": "^7.17.0",
    "@umijs/max": "^4.6.59",
    "ahooks": "^3.9.7",
    "antd": "^5.15.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "echarts-for-react": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,css,less,md,json}": "prettier --write"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.21.4": true,
    "core-js@3.34.0": true,
    "core-js-pure@3.49.0": true,
    "es5-ext@0.10.64": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
